  "house": { "type": "rest", "name": "Sylvie's house", "icon": "🏠", "sprite": "grok_nuv/cottage", "size": 1.2, "text": "Whitewashed walls and a red roof. Sylvie says you can sleep here: an hour's rest fills your energy, once a day." },
  "hut": { "type": "look", "name": "the fishing hut", "icon": "🛖", "sprite": "gemini_nuv/fishinghut", "dy": 0.04, "dx": -0.04, "size": 0.85, "text": "Nets drying, nobody home. A boat-shaped dent in the sand where a boat used to be." },
