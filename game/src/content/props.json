  "tent": { "type": "look", "name": "the command tent", "icon": "⛺", "sprite": "grok_nuv/tent", "size": 1.0, "text": "Canvas stamped with a golden sun. Locked chests, rolled-up maps." },
  "pillars": { "type": "look", "name": "the old pillars", "icon": "🏛️", "sprite": "grok_nuv/pillars", "size": 0.75, "text": "Dragon Empire stonework, older than anything else on this shore." },
  "drill": { "type": "look", "name": "the drill", "icon": "🏗️", "sprite": "grok_nuv/drill", "size": 0.85, "text": "A Saints drill, still warm. Nobody's here. Fresh boot prints lead down to the water." },
