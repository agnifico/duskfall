  "house": { "type": "rest", "name": "Sylvie's house", "icon": "🏠", "sprite": "grok_nuv/cottage", "size": 1.04, "text": "Whitewashed walls and a red roof. Sylvie says you can sleep here: an hour's rest fills your energy, once a day." },
  "hut": { "type": "look", "name": "the fishing hut", "icon": "🛖", "sprite": "gemini_nuv/fishinghut", "dy": 0.04, "dx": -0.04, "size": 0.85, "text": "Nets drying, nobody home. A boat-shaped dent in the sand where a boat used to be." },
  "fire": { "type": "fire", "name": "the campfire", "icon": "🔥", "sprite": "grok_nuv/campfire", "size": 0.62, "dx": 0, "dy": -0.07,"flat": true, "text": "It never quite goes out. Sit a while and your wounds ache less; feed it a log and your legs come back." },
  "tent": { "type": "look", "name": "the command tent", "icon": "⛺", "sprite": "grok_nuv/tent", "size": 1.0, "text": "Canvas stamped with a golden sun: Claudia and Cygwin's tent. Maps, a card table, two neat cots." },
  "pillars": { "type": "look", "name": "the old pillars", "icon": "🏛️", "sprite": "grok_nuv/pillars", "size": 0.75, "text": "Dragon Empire stonework, older than anything else on this shore." },
  "drill": { "type": "look", "name": "the drill", "icon": "🏗️", "sprite": "grok_nuv/drill", "size": 0.85, "text": "The Saints' drill, the size of a house, thumping away at the rock. You feel it in your teeth." },
  "chest": { "type": "secret", "name": "Old chest", "icon": "🧰", "sprite": "grok_nuv/chest", "size": 0.55, "item": "coin", "amount": 3, "text": "Iron-bound and half-buried. The lock gave up years ago." },
  "glint": { "type": "secret", "name": "Something glinting", "icon": "✨", "hidden": true, "item": "sea-glass", "amount": 1, "text": "A flash of colour in the sand." },
  "crab": { "type": "enemy", "name": "crab runt", "icon": "🦀", "sprite": "gemini_foes/crab", "size": 0.53, "text": "A crab that has appointed itself guard of this beach. Claws up, very serious about it.",
    "foe": { "level": 1, "mult": { "hp": 0.9, "patk": 0.7, "eatk": 0.7, "pdef": 2, "edef": 1.5 }, "stats": { "spd": 10, "eva": 5, "prc": 5 }, "drops": [{ "item": "crab-shell", "chance": 1, "n": [1, 2] }, { "item": "crab-meat", "chance": 0.6 }, { "item": "smoked-claw", "chance": 0.06 }, { "item": "traveller-feet", "chance": 0.04 }], "behaviour": "still", "res": 10, "attack": { "shape": "arc", "width": 1 } } },
  "boar": { "type": "enemy", "name": "grunt runt", "icon": "🐗", "sprite": "gemini_foes/boar", "size": 0.6, "text": "Huffing, snorting, charging. Not always at you, but it gives it everything.",
    "foe": { "level": 2, "mult": { "hp": 0.9, "patk": 0.8, "eatk": 0.8 }, "stats": { "spd": 20, "eva": 5, "prc": 10 }, "drops": [{ "item": "boar-hide", "chance": 1, "n": [1, 2] }, { "oneOf": ["traveller-head", "traveller-body", "traveller-hands", "traveller-legs"], "chance": 0.05 }], "behaviour": "territorial", "notice": 1, "res": 30, "attack": { "shape": "arc", "width": 1 } } },
  "riled-crab": { "type": "enemy", "name": "riled crab runt", "icon": "🦀", "sprite": "gemini_foes/crab", "size": 0.6, "text": "Claws up, eyes wrong. Crabs don't come looking for a fight. This one did.",
    "foe": { "level": 1, "mult": { "hp": 0.4, "patk": 0.3, "eatk": 0.3 }, "stats": { "spd": 10, "eva": 5, "prc": 5 }, "drops": [{ "item": "crab-shell", "chance": 1 }, { "item": "crab-meat", "chance": 1 }], "behaviour": "territorial", "notice": 8, "attack": { "shape": "arc", "width": 1 } } },
  "riled-toxolotl": { "type": "enemy", "name": "riled toxolotl", "icon": "🦎", "sprite": "djv2/toxolotl", "size": 0.67, "text": "Out of the water and coming at you, frills flared.",
    "foe": { "level": 1, "mult": { "hp": 0.4, "patk": 0.3, "eatk": 0.3 }, "stats": { "spd": 10, "eva": 0, "prc": 5 }, "drops": [{ "item": "toxolotl-frill", "chance": 1 }], "behaviour": "territorial", "notice": 8, "attack": { "shape": "arc", "width": 1 } } },
  "toxolotl": { "type": "enemy", "name": "toxolotl", "icon": "🦎", "sprite": "djv2/toxolotl", "size": 0.6, "text": "Frilled, finned and lazing in the shallows. It won't move for you.",
    "foe": { "level": 1, "mult": { "hp": 0.9, "patk": 0.6, "eatk": 0.6 }, "stats": { "spd": 10, "eva": 0, "prc": 5 }, "drops": [{ "item": "toxolotl-frill", "chance": 1 }, { "item": "spirit-tonic", "chance": 0.04 }], "behaviour": "still", "res": 10, "attack": { "shape": "arc", "width": 1 } } },
  "bear": { "type": "enemy", "name": "bear", "icon": "🐻", "sprite": "djv2/bear1", "size": 1.0, "text": "Plated like bark and slow to anger. Slow, full stop.",
    "foe": { "level": 5, "mult": { "hp": 1.4, "patk": 1.1, "eatk": 1.1, "pdef": 1.3, "edef": 1.3 }, "stats": { "spd": 15, "eva": 0, "prc": 5 }, "drops": [{ "item": "bear-pelt", "chance": 1, "n": [1, 2] }, { "oneOf": ["padded-head", "padded-body", "padded-hands", "padded-legs", "padded-feet"], "chance": 0.06 }], "behaviour": "territorial", "notice": 1, "res": 40, "attack": { "shape": "arc", "width": 1 } } },
  "prowler": { "type": "enemy", "name": "forest prowler", "icon": "🐆", "sprite": "djv2/forest_prowler", "size": 0.95, "text": "Green runes down its back. It sees you before you see it.",
    "foe": { "level": 11, "mult": { "hp": 0.75 }, "stats": { "spd": 30, "eva": 15, "prc": 10 }, "drops": [{ "item": "prowler-fang", "chance": 1 }, { "oneOf": ["padded-hands", "padded-feet"], "chance": 0.05 }, { "item": "health-potion", "chance": 0.04 }], "behaviour": "territorial", "notice": 2, "res": 30, "attack": { "shape": "arc", "width": 1 } } },
  "dragonling": { "type": "enemy", "name": "dragonling", "icon": "🐉", "sprite": "djv2/dragon", "size": 0.9, "text": "A baby dragon, minding its patch. Its breath reaches two hexes.",
    "foe": { "level": 8, "mult": { "hp": 1.1, "patk": 1.2, "eatk": 1.2 }, "stats": { "spd": 20, "eva": 5, "prc": 10 }, "drops": [{ "item": "dragon-scale", "chance": 0.6 }, { "item": "red-crystal", "chance": 0.25 }, { "oneOf": ["padded-head", "padded-body", "padded-hands", "padded-legs", "padded-feet"], "chance": 0.08 }], "behaviour": "still", "res": 30, "attack": { "shape": "line", "length": 2 } } },
  "sylvie": { "type": "npc", "name": "Sylvie", "icon": "🧝‍♀️", "npc": "sylvie" },
  "aurelie": { "type": "npc", "name": "Sister Aurelie", "icon": "✝️", "npc": "aurelie" },
  "claudia": { "type": "npc", "name": "Claudia", "icon": "❄️", "npc": "claudia" },
  "cygwin": { "type": "npc", "name": "Cygwin", "icon": "⚔️", "npc": "cygwin" },
  "marisol": { "type": "npc", "name": "Marisol", "icon": "🎣", "npc": "marisol" },
  "brann": { "type": "npc", "name": "Brann", "icon": "🔨", "npc": "brann" },
  "tova": { "type": "npc", "name": "Old Tova", "icon": "🧶", "npc": "tova" },
  "heidi": { "type": "npc", "name": "Heidi", "icon": "🌼", "npc": "heidi" },
  "start": { "type": "start", "name": "Start", "icon": "📍", "text": "Where you arrive on this point (without it, the way out). Only shown in the editor." },
  ">": { "type": "exit", "name": "Beacon", "icon": "🚩", "sprite": "grok_wreck/lantern", "size": 0.5, "text": "The way out. Shown only on fog maps, as a beacon seen from anywhere; elsewhere it marks the start if there is no start marker." },
  "biceon": {"type": "enemy", "name": "biceon", "icon": "🐐", "sprite": "djv2/biceon", "size": 0.95, "text": "Horned, shaggy, and it grazes the plains like it owns them. It does, more or less.", "foe": {"level": 9, "mult": {"hp": 1.2, "pdef": 1.1}, "stats": {"spd": 15, "eva": 5, "prc": 10}, "drops": [{"item": "bear-pelt", "chance": 0.7}, {"item": "seed-bread", "chance": 0.06}, {"oneOf": ["padded-head", "padded-legs"], "chance": 0.05}], "behaviour": "territorial", "notice": 1, "res": 40, "attack": {"shape": "arc", "width": 3}}},
  "punching-tortoise": {"type": "enemy", "name": "punching tortoise", "icon": "🐢", "sprite": "djv2/punching_tortoise", "size": 1.0, "text": "It sits in the shallows and it punches. That's the whole plan, and it works.", "foe": {"level": 12, "mult": {"hp": 1.6, "pdef": 1.5, "edef": 0.8, "patk": 1.2}, "stats": {"spd": 10, "eva": 0, "prc": 10}, "drops": [{"item": "crab-shell", "chance": 1, "n": [2, 3]}, {"item": "health-potion", "chance": 0.08}, {"item": "honey-cake", "chance": 0.05}, {"item": "padded-body", "chance": 0.06}], "behaviour": "still", "res": 50, "attack": {"shape": "arc", "width": 1}}},
  "basilisk": {"type": "enemy", "name": "mountain basilisk", "icon": "🐍", "sprite": "djv2/mountain_basilisk", "size": 0.95, "text": "Down from the mountains, coiled on the warm rocks. Its gaze carries two hexes.", "foe": {"level": 14, "mult": {"hp": 1.1, "patk": 1.2, "eatk": 1.3, "edef": 1.3}, "stats": {"spd": 20, "eva": 10, "prc": 15}, "drops": [{"item": "dragon-scale", "chance": 0.6}, {"item": "red-crystal", "chance": 0.25}, {"item": "energy-draught", "chance": 0.08}, {"item": "spirit-tonic", "chance": 0.06}, {"oneOf": ["padded-head", "padded-body", "padded-hands", "padded-legs", "padded-feet"], "chance": 0.08}], "behaviour": "territorial", "notice": 2, "res": 60, "attack": {"shape": "line", "length": 2}}},
  "crabscallion": {"type": "enemy", "name": "crabscallion", "icon": "🦞", "sprite": "gemini_foes/crab2", "size": 0.95, "text": "A crab runt that kept growing, and kept the attitude. Hired muscle now, or it thinks it is.", "foe": {"level": 16, "mult": {"hp": 1.3, "pdef": 1.4, "edef": 1.1}, "stats": {"spd": 15, "eva": 5, "prc": 10}, "drops": [{"item": "crab-shell", "chance": 1, "n": [2, 3]}, {"item": "crab-meat", "chance": 0.8}, {"item": "iron-ore", "chance": 0.2, "n": [1, 2]}, {"oneOf": ["iron-head", "iron-body", "iron-hands", "iron-legs", "iron-feet"], "chance": 0.03}], "behaviour": "territorial", "notice": 1, "res": 60, "attack": {"shape": "arc", "width": 3}}},
  "boaring-captain": {"type": "enemy", "name": "boaring captain", "icon": "🐗", "sprite": "gemini_foes/boar2", "size": 1.0, "text": "An axe, a belt buckle the size of a plate, and a temper to match. Says he's on the payroll.", "foe": {"level": 18, "mult": {"hp": 1.2, "patk": 1.3}, "stats": {"spd": 20, "eva": 5, "prc": 15}, "drops": [{"item": "boar-hide", "chance": 1, "n": [2, 3]}, {"item": "coin", "chance": 0.7, "n": [4, 10]}, {"oneOf": ["iron-sword", "iron-axe", "iron-spear"], "chance": 0.04}, {"oneOf": ["iron-head", "iron-body", "iron-hands", "iron-legs", "iron-feet"], "chance": 0.04}], "behaviour": "territorial", "notice": 2, "res": 70, "attack": {"shape": "arc", "width": 1}}},
  "solis-sentinel": {"type": "enemy", "name": "Solis sentinel", "icon": "🛡️", "sprite": "djv2/solis_sentinel", "size": 1.0, "text": "It stands guard and does not look at you. It will, if you make it.", "foe": {"level": 20, "mult": {"hp": 1.8, "patk": 1.3, "pdef": 1.6, "edef": 1.6}, "stats": {"spd": 15, "eva": 5, "prc": 15}, "drops": [{"item": "iron-ore", "chance": 1, "n": [3, 5]}, {"item": "coin", "chance": 1, "n": [10, 20]}, {"oneOf": ["iron-head", "iron-body", "iron-hands", "iron-legs", "iron-feet"], "chance": 0.06}], "behaviour": "still", "res": 80, "attack": {"shape": "arc", "width": 3}}},
  "cottage": {"type": "look", "name": "a fisher's cottage", "icon": "🏠", "sprite": "grok_nuv/cottage", "size": 0.95, "text": "Whitewashed, salt-stained, a net hung over the door to dry."},
  "net": {"type": "look", "name": "drying nets", "icon": "🕸️", "sprite": "grok_wreck/net", "size": 0.6, "text": "Old Tova's work, mended so many times there's more knot than net."},
  "barrel": {"type": "look", "name": "a barrel", "icon": "🛢️", "sprite": "grok_wreck/barrel", "size": 0.45, "text": "Salted fish. Less of it than there should be."},
  "crate": {"type": "look", "name": "crates", "icon": "📦", "sprite": "grok_wreck/crate", "size": 0.5, "text": "Stamped with a golden sun. Saints' supplies, paid for, stacked neatly."},
  "rowboat": {"type": "look", "name": "Saltmere's boat", "icon": "🚣", "sprite": "grok_wreck/rowboat", "dx": -0.105, "size": 0.42, "text": "A sturdy boat, pulled up on the sand. One day it'll take you out past the bay."},
  "verona": {"type": "npc", "name": "Verona", "icon": "🍃", "npc": "verona"},
  "deadtree": {"type": "look", "name": "a burnt tree", "icon": "🪵", "sprite": "grok_nuv/deadtree", "size": 0.9, "text": "Black to the heart. Lightning, years back. Green shoots at its feet already."},
  "sapling": {"type": "look", "name": "a sapling", "icon": "🌱", "sprite": "grok_nodes/sapling", "size": 0.45, "text": "New growth where the fire went through. The island heals itself."},
  "searock": {"type": "look", "name": "a sea rock", "icon": "🪨", "sprite": "grok_wreck/searock", "size": 0.7, "text": "Barnacled and slick. Gulls argue over it."},
  "reef": {"type": "look", "name": "a reef", "icon": "🪸", "sprite": "grok_wreck/reef", "size": 0.7, "text": "Coral, pale at the tips. It should be brighter than this."},
  "mast": {"type": "look", "name": "a sunken mast", "icon": "⛵", "sprite": "grok_wreck/mast", "size": 0.8, "text": "Something big went down out here. Long before the drill."},
  "figurehead": {"type": "look", "name": "a figurehead", "icon": "🗿", "sprite": "grok_wreck/figurehead", "size": 0.6, "text": "A carved woman with a crown of shells, half sunk. Her face has been scrubbed clean, recently."},
  "verona-duel": {"type": "enemy", "name": "Verona", "icon": "🍃", "text": "She doesn't hold back. She doesn't hate you either. She just wants to know what you are.", "foe": {"level": 24, "mult": {"hp": 2.2, "patk": 1.4, "pdef": 1.3, "edef": 1.3}, "stats": {"spd": 25, "eva": 20, "prc": 20}, "drops": [{"item": "coin", "chance": 1, "n": [20, 30]}], "behaviour": "territorial", "notice": 10, "res": 90, "attack": {"shape": "line", "length": 2}}},
