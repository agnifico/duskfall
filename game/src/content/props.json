  "berries": { "type": "node", "skill": "foraging", "name": "Berry bush", "icon": "🫐", "sprite": "grok_nodes/berrybush", "size": 0.62, "tier": 1, "verb": "Pick", "item": "berries", "yield": [2, 4], "cost": 1, "bonus": { "item": "herbs", "chance": 0.3 } },
