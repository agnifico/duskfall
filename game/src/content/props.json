  "glint": { "type": "secret", "name": "Something glinting", "icon": "✨", "hidden": true, "item": "sea-glass", "amount": 1, "text": "A flash of colour in the sand." },
  "crab": { "type": "enemy", "name": "pinchwarden", "icon": "🦀", "text": "A crab that has appointed itself guard of this beach. Claws up, very serious about it.",
    "foe": { "level": 1, "mult": { "hp": 0.9, "patk": 0.7, "eatk": 0.7, "pdef": 2, "edef": 1.5 }, "stats": { "spd": 10, "eva": 5, "prc": 5 }, "drops": [{ "item": "crab-shell", "chance": 1, "n": [1, 2] }, { "item": "smoked-claw", "chance": 0.06 }, { "item": "traveller-feet", "chance": 0.04 }], "behaviour": "still", "res": 10, "attack": { "shape": "arc", "width": 1 } } },
  "boar": { "type": "enemy", "name": "grumbletusk", "icon": "🐗", "text": "Huffing, snorting, charging. Not always at you, but it gives it everything.",
    "foe": { "level": 3, "stats": { "spd": 20, "eva": 5, "prc": 10 }, "drops": [{ "item": "boar-hide", "chance": 1, "n": [1, 2] }, { "oneOf": ["traveller-head", "traveller-body", "traveller-hands", "traveller-legs"], "chance": 0.05 }], "behaviour": "territorial", "notice": 1, "res": 30, "attack": { "shape": "arc", "width": 1 } } },
  "riled-crab": { "type": "enemy", "name": "riled pinchwarden", "icon": "🦀", "text": "Claws up, eyes wrong. Crabs don't come looking for a fight. This one did.",
    "foe": { "level": 1, "mult": { "hp": 0.4, "patk": 0.3, "eatk": 0.3 }, "stats": { "spd": 10, "eva": 5, "prc": 5 }, "drops": [{ "item": "crab-shell", "chance": 1 }], "behaviour": "territorial", "notice": 8, "attack": { "shape": "arc", "width": 1 } } },
  "riled-toxolotl": { "type": "enemy", "name": "riled toxolotl", "icon": "🦎", "sprite": "djv2/toxolotl", "size": 0.8, "text": "Out of the water and coming at you, frills flared.",
    "foe": { "level": 1, "mult": { "hp": 0.4, "patk": 0.3, "eatk": 0.3 }, "stats": { "spd": 10, "eva": 0, "prc": 5 }, "drops": [{ "item": "toxolotl-frill", "chance": 1 }], "behaviour": "territorial", "notice": 8, "attack": { "shape": "arc", "width": 1 } } },
  "toxolotl": { "type": "enemy", "name": "toxolotl", "icon": "🦎", "sprite": "djv2/toxolotl", "size": 0.8, "text": "Frilled, finned and lazing in the shallows. It won't move for you.",
    "foe": { "level": 1, "mult": { "hp": 0.9, "patk": 0.6, "eatk": 0.6 }, "stats": { "spd": 10, "eva": 0, "prc": 5 }, "drops": [{ "item": "toxolotl-frill", "chance": 1 }, { "item": "spirit-tonic", "chance": 0.04 }], "behaviour": "still", "res": 10, "attack": { "shape": "arc", "width": 1 } } },
  "bear": { "type": "enemy", "name": "bear", "icon": "🐻", "sprite": "djv2/bear1", "size": 1.0, "text": "Plated like bark and slow to anger. Slow, full stop.",
    "foe": { "level": 5, "mult": { "hp": 1.4, "patk": 1.1, "eatk": 1.1, "pdef": 1.3, "edef": 1.3 }, "stats": { "spd": 15, "eva": 0, "prc": 5 }, "drops": [{ "item": "bear-pelt", "chance": 1, "n": [1, 2] }, { "oneOf": ["padded-head", "padded-body", "padded-hands", "padded-legs", "padded-feet"], "chance": 0.06 }], "behaviour": "territorial", "notice": 1, "res": 40, "attack": { "shape": "arc", "width": 1 } } },
  "prowler": { "type": "enemy", "name": "forest prowler", "icon": "🐆", "sprite": "djv2/forest_prowler", "size": 0.95, "text": "Green runes down its back. It sees you before you see it.",
    "foe": { "level": 6, "mult": { "hp": 0.75 }, "stats": { "spd": 30, "eva": 15, "prc": 10 }, "drops": [{ "item": "prowler-fang", "chance": 1 }, { "oneOf": ["padded-hands", "padded-feet"], "chance": 0.05 }], "behaviour": "territorial", "notice": 2, "res": 30, "attack": { "shape": "arc", "width": 1 } } },
  "dragonling": { "type": "enemy", "name": "dragonling", "icon": "🐉", "sprite": "djv2/dragon", "size": 0.9, "text": "A baby dragon, minding its patch. Its breath reaches two hexes.",
